# mc build artefacts
build/
*.o
*.a
*.so
*.so.*
# Whitelist: prebuilt blobs we DO commit, no source available
!deps_libs/*/mali/*.so
!deps_libs/*/mali/*.so.*
!deps_libs/*/mali/*.a
!deps_libs/*/tslib/lib/*.so
!deps_libs/*/tslib/lib/*.so.*
!deps_libs/*/tslib/lib/ts/*.so
# Whitelist: LVGL pre-built static lib (rebuildable from source under deps_source/)
!deps_libs/*/lvgl/liblvgl9.a

# Auto-generated dep files (-MMD -MP)
*.d

# LVGL: intermediate build dir only (lib + conf are kept)
deps_libs/*/lvgl/build/

# AWTK build outputs
deps_source/*/awtk/awtk-linux-fb/bin/
deps_source/*/awtk/awtk-linux-fb/lib/
deps_source/*/awtk/awtk-linux-fb/build/
deps_source/*/awtk/awtk-linux-fb/out/
deps_source/*/awtk/awtk/bin/
deps_source/*/awtk/awtk/lib/
deps_source/*/awtk/awtk/build/
**/awtk-port/**/*.o
**/awtk-port/**/*.d

# SCons cache
.sconsign.dblite
.sconf_temp/
config.log

# Editor/IDE
.vscode/
.idea/
*.swp
*~

# OS junk
.DS_Store
Thumbs.db

# build.sh products
output/

# Vendor source archives (we keep the extracted tree under deps_source/)
*.zip

# debug screenshots
*.bmp
